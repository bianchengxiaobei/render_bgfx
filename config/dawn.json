  "version": 1,
  "lightmap": {
    "uv2VFlip": false,
    "texelsPerUnit": 6.0,
    "maxLightmapSize": 1024,
    "atlasSize": 2048,
    "maxAtlases": 2,
    "padding": 2,
    "dilationIterations": 4,
