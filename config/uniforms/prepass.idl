block Object {
    mat4 prevModel;          # previous-frame world matrix
    vec4 lightLayerMask;     # x = 16-bit object mask, w = light-layers enabled
    vec4 lightmapST;         # xy = lightmap UV scale, zw = offset
    vec4 lightmapParams;     # x = enabled, y = SH layer base, zw = unused
}

block Prepass {
    vec4 depthPyramidParams; # xy = source texel size, zw = unused
}
