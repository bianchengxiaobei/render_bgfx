#ifndef HBG_LIT_VARIANTS_SC
#define HBG_LIT_VARIANTS_SC

#define HBG_LIT_VARIANT_COUNT 29u

#define HBG_LIT_MATERIAL_STANDARD 1u
#define HBG_LIT_MATERIAL_SUBSURFACE 4u
#define HBG_LIT_MATERIAL_TRANSMISSION 8u
#define HBG_LIT_MATERIAL_ANISOTROPY 16u
#define HBG_LIT_MATERIAL_IRIDESCENCE 32u
#define HBG_LIT_MATERIAL_CLEAR_COAT 64u

#define HBG_LIT_LIGHT_PUNCTUAL (1u << 12u)
#define HBG_LIT_LIGHT_AREA (1u << 13u)
#define HBG_LIT_LIGHT_DIRECTIONAL (1u << 14u)
#define HBG_LIT_LIGHT_SHADOWS (1u << 15u)

// Mirrors render::kLitFeatureVariantFlags in src/render/passes/deferred_variant.h.
uint hbgLitVariantFeatureFlags(uint variant)
{
    if (variant == 0u) return HBG_LIT_MATERIAL_STANDARD;
    if (variant == 1u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL;
    if (variant == 2u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL;
    if (variant == 3u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_AREA;
    if (variant == 4u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA;
    if (variant == 5u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_SHADOWS;
    if (variant == 6u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_SHADOWS;
    if (variant == 7u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA | HBG_LIT_LIGHT_SHADOWS;
    if (variant == 8u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION;
    if (variant == 9u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION | HBG_LIT_LIGHT_DIRECTIONAL;
    if (variant == 10u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL;
    if (variant == 11u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_AREA;
    if (variant == 12u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA;
    if (variant == 13u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_ANISOTROPY;
    if (variant == 14u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_ANISOTROPY | HBG_LIT_LIGHT_DIRECTIONAL;
    if (variant == 15u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_ANISOTROPY | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL;
    if (variant == 16u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_ANISOTROPY | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_AREA;
    if (variant == 17u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_ANISOTROPY | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA;
    if (variant == 18u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_CLEAR_COAT;
    if (variant == 19u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_CLEAR_COAT | HBG_LIT_LIGHT_DIRECTIONAL;
    if (variant == 20u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_CLEAR_COAT | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL;
    if (variant == 21u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_CLEAR_COAT | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_AREA;
    if (variant == 22u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_CLEAR_COAT | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA;
    if (variant == 23u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_IRIDESCENCE;
    if (variant == 24u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_IRIDESCENCE | HBG_LIT_LIGHT_DIRECTIONAL;
    if (variant == 25u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_IRIDESCENCE | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL;
    if (variant == 26u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_IRIDESCENCE | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_AREA;
    if (variant == 27u) return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_IRIDESCENCE | HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA;
    return HBG_LIT_MATERIAL_STANDARD | HBG_LIT_MATERIAL_SUBSURFACE | HBG_LIT_MATERIAL_TRANSMISSION |
           HBG_LIT_MATERIAL_ANISOTROPY | HBG_LIT_MATERIAL_IRIDESCENCE | HBG_LIT_MATERIAL_CLEAR_COAT |
           HBG_LIT_LIGHT_DIRECTIONAL | HBG_LIT_LIGHT_PUNCTUAL | HBG_LIT_LIGHT_AREA | HBG_LIT_LIGHT_SHADOWS;
}

uint hbgLitVariantFor(uint featureFlags)
{
    for (uint variant = 0u; variant < HBG_LIT_VARIANT_COUNT; ++variant)
    {
        if ((featureFlags & hbgLitVariantFeatureFlags(variant)) == featureFlags)
        {
            return variant;
        }
    }
    return HBG_LIT_VARIANT_COUNT - 1u;
}

uint hbgLitMaterialFlagsFromFeatures(uint features)
{
    uint flags = HBG_LIT_MATERIAL_STANDARD;
    if ((features & 1u) != 0u) flags |= HBG_LIT_MATERIAL_CLEAR_COAT;
    if ((features & 2u) != 0u) flags |= HBG_LIT_MATERIAL_TRANSMISSION;
    if ((features & 64u) != 0u) flags |= HBG_LIT_MATERIAL_SUBSURFACE;
    if ((features & 16u) != 0u) flags |= HBG_LIT_MATERIAL_ANISOTROPY;
    if ((features & 8u) != 0u) flags |= HBG_LIT_MATERIAL_IRIDESCENCE;
    return flags;
}

#endif // HBG_LIT_VARIANTS_SC
