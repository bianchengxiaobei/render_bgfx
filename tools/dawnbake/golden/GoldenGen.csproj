<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GoldenGen</AssemblyName>
    <RootNamespace>DawnGolden</RootNamespace>
    <!--
      Frozen reference: com.tencent.dawn v2.4.5, protocol 1002.
      Override DawnProtocolDir on the dotnet command line when the checkout lives elsewhere.
    -->
    <DawnProtocolDir Condition="'$(DawnProtocolDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\dawnlight\com.tencent.dawn\Editor\DawnProtocol</DawnProtocolDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DawnProtocolDir)\BakingCoreDefine.cs" Link="protocol\BakingCoreDefine.cs" />
    <Compile Include="$(DawnProtocolDir)\BakingSceneDefine.cs" Link="protocol\BakingSceneDefine.cs" />
    <Compile Include="$(DawnProtocolDir)\BakingJobDefine.cs" Link="protocol\BakingJobDefine.cs" />
    <Compile Include="$(DawnProtocolDir)\SerializeUtil.cs" Link="protocol\SerializeUtil.cs" />
  </ItemGroup>

</Project>
