{
  "version": 1,
  "name": "CurveUnlit",
  "properties": [
    {"name": "Tint", "type": "color", "default": [1.0, 0.55, 0.2, 1.0]},
    {"name": "Size", "type": "float", "default": 0.2},
    {"name": "MainTex", "type": "texture", "default": "textures/spark.png"},
    {"name": "SizeCurve", "type": "curve", "keys": [[0.0, 0.2], [0.5, 1.0], [1.0, 0.0]]},
    {"name": "ColorRamp", "type": "gradient", "keys": [
      {"t": 0.0, "color": [1.0, 1.0, 1.0, 1.0]},
      {"t": 0.5, "color": [1.0, 0.5, 0.1, 1.0]},
      {"t": 1.0, "color": [1.0, 0.0, 0.0, 0.0]}
    ]}
  ],
  "systems": [
    {
      "name": "Sparks",
      "capacity": 64,
      "space": "local",
      "bounds": {"mode": "manual", "center": [0, 1, 0], "extents": [4, 4, 4]},
      "spawner": {
        "rate": 40,
        "bursts": [{"time": 0.0, "count": 8}]
      },
      "init": {
        "blocks": [
          {"type": "set_position_box", "center": [0, 1, 0], "size": [1, 0.2, 1]},
          {"type": "set_velocity_random", "minSpeed": 0.2, "maxSpeed": 0.8},
          {"type": "set_color", "color": {"op": "property", "name": "Tint"}},
          {"type": "set_size", "size": {"op": "property", "name": "Size"}},
          {"type": "set_lifetime", "lifetime": 1.5}
        ]
      },
      "update": {
        "blocks": [
          {"type": "integrate"},
          {"type": "age"},
          {"type": "reap"}
        ]
      },
      "outputs": [
        {"type": "quad", "lit": false, "blend": "additive", "texture": "MainTex"}
      ]
    }
  ]
