{
  "version": 1,
  "name": "CustomHlslVisual",
  "systems": [
    {
      "name": "CustomHlslVisual",
      "capacity": 24,
      "space": "world",
      "bounds": {"mode": "manual", "center": [0, 0, 0], "extents": [2, 2, 2]},
      "spawner": {
        "rate": 0,
        "bursts": [{"time": 0.0, "count": 24}]
      },
      "init": {
        "blocks": [
          {"type": "set_position_box", "center": [0, 0, 0], "size": [2.4, 1.2, 0]},
          {"type": "set_lifetime", "lifetime": 100.0},
          {
            "type": "custom_hlsl",
            "code": "float t = saturate(VFX_ATTR(position).x * 0.5 + 0.5);\nVFX_SET_ATTR(color, lerp(float3(0.1, 0.4, 1.0), float3(1.0, 0.35, 0.1), t));\nVFX_SET_ATTR(alpha, 0.9);\nVFX_SET_ATTR(size, 0.34);",
            "reads": ["position"],
            "writes": ["color", "alpha", "size"]
          }
        ]
      },
      "update": {
        "blocks": [
          {"type": "age"}
        ]
      },
      "outputs": [
        {"type": "quad", "lit": false, "blend": "alpha", "texture": ""}
      ]
    }
  ]
}
